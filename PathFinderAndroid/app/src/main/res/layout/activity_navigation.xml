<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F6F8">
    <fragment
        android:id="@+id/navigation_fragment"
        android:name="com.google.android.libraries.navigation.SupportNavigationFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/guide_panel"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blind Guide"
                android:textColor="#123247"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:text="Preparing navigation…"
                android:textColor="#123247"
                android:textSize="17sp" />
            <TextView
                android:id="@+id/sensor_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:text="ESP32: waiting to connect"
                android:textColor="#174F38"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/voice_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Voice ready"
                android:textColor="#405665"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/destination_input"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:hint="Destination name and area"
                android:imeOptions="actionDone"
                android:inputType="textCapWords|textPostalAddress"
                android:singleLine="true"
                android:textSize="17sp" />
            <Button
                android:id="@+id/navigate_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="Start walking directions"
                android:textSize="17sp" />
            <Button
                android:id="@+id/voice_command_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:text="Speak destination / command"
                android:textSize="16sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/retry_esp_button"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Retry ESP32" />
                <Button
                    android:id="@+id/stop_button"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Stop everything" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
